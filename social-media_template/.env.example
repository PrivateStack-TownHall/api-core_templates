# WAJIB SAMA PERSIS di kelima app Operations Core - kelimanya connect ke
# database fisik yang sama (1 Postgres, 1 schema "public", shared users table).
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require

JWT_SECRET=change_this_to_a_long_random_secret

PORT=3002
