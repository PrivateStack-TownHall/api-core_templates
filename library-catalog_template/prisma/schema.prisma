// ============================================================================
// OPERATIONS CORE - MASTER SCHEMA
// ============================================================================
// File ini WAJIB identik di kelima folder app (pineapple-stack, codigram,
// m-ployee, leather-shelf, waretrack) karena kelimanya connect ke database
// fisik yang sama. Migration cukup dijalankan sekali dari salah satu app;
// app lain tinggal `prisma generate` (migration history-nya sudah sama-sama
// tercatat di database yang sama).
//
// Kalau nambah/ubah model, edit di sini dulu, baru copy paste identik ke
// kelima folder prisma/schema.prisma lainnya.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SHARED - dipakai oleh semua app
// ============================================================================

enum AppType {
  PINEAPPLE
  WARETRACK
  MPLOYEE
  CODIGRAM
  LEATHER
}

enum Role {
  MEMBER
  ADMIN
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  fullName String
  role     Role   @default(MEMBER)
  isActive Boolean @default(true)

  // Field ekstensi opsional per-app - sengaja ditaruh langsung di User
  // (bukan tabel profile terpisah per app) biar simpel, karena tiap app
  // cuma butuh beberapa kolom tambahan, bukan satu set field yang besar.
  bio             String? // Pineapple Stack, Codigram
  avatarUrl       String? // Pineapple Stack, Codigram
  employeeCode    String? // M-ployee
  membershipNumber String? // Leather Shelf
  favoriteGenre   String? // Leather Shelf
  warehouseId     String? // WareTrack - staff bertugas di warehouse mana
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // Relations - Pineapple Stack
  threads        Thread[]
  threadComments ThreadComment[]
  threadLikes    ThreadLike[]
  threadStars    ThreadStar[]

  // Relations - Codigram
  posts        Post[]
  postComments PostComment[]
  postLikes    PostLike[]

  // Relations - M-ployee
  employeeProfile EmployeeProfile?

  // Relations - Leather Shelf
  reviews Review[]

  // Relations - shared
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
  auditLogs              AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Notification generik - dipakai Pineapple Stack (like/comment thread) dan
// Codigram (like/comment post). entityType + entityId nunjuk ke record
// pemicu notif (mis. entityType "Thread", entityId ke Thread.id).
model Notification {
  id         String  @id @default(uuid())
  recipientId String
  actorId    String?
  type       String
  entityType String?
  entityId   String?
  isRead     Boolean @default(false)

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([recipientId])
  @@map("notifications")
}

model AuditLog {
  id     String @id @default(uuid())
  userId String?

  action   String
  entity   String
  entityId String?
  appType  AppType

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([appType])
  @@map("audit_logs")
}

// ============================================================================
// PINEAPPLE STACK - forum diskusi
// ============================================================================

model Thread {
  id       String  @id @default(uuid())
  userId   String
  title    String
  slug     String  @unique
  body     String
  category String?

  author   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments ThreadComment[]
  likes    ThreadLike[]
  stars    ThreadStar[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("threads")
}

model ThreadComment {
  id       String @id @default(uuid())
  threadId String
  userId   String
  body     String

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("thread_comments")
}

model ThreadLike {
  id       String @id @default(uuid())
  threadId String
  userId   String

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, threadId])
  @@map("thread_likes")
}

model ThreadStar {
  id       String @id @default(uuid())
  threadId String
  userId   String

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, threadId])
  @@map("thread_stars")
}

// ============================================================================
// WARETRACK - manajemen inventori gudang
// ============================================================================

enum MovementType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model ProductCategory {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  icon        String?
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Product {
  id           String  @id @default(uuid())
  categoryId   String
  brandId      String?
  sku          String  @unique
  barcode      String? @unique
  name         String
  description  String?
  unit         String
  costPrice    Decimal @db.Decimal(12, 2)
  sellingPrice Decimal @db.Decimal(12, 2)
  minimumQty   Int     @default(0)
  maximumQty   Int?
  isActive     Boolean @default(true)

  category ProductCategory @relation(fields: [categoryId], references: [id])
  brand    Brand?           @relation(fields: [brandId], references: [id])

  stocks        Stock[]
  purchaseItems PurchaseItem[]
  transferItems TransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Warehouse {
  id       String @id @default(uuid())
  code     String @unique
  name     String
  address  String?
  capacity Int

  locations WarehouseLocation[]
  stocks    Stock[]
  staff     User[]
  outgoing  Transfer[] @relation("FromWarehouse")
  incoming  Transfer[] @relation("ToWarehouse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

model WarehouseLocation {
  id          String    @id @default(uuid())
  warehouseId String
  code        String    @unique
  name        String
  capacity    Int

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stocks    Stock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouse_locations")
}

model Stock {
  id          String  @id @default(uuid())
  warehouseId String
  locationId  String?
  productId   String
  quantity    Int     @default(0)
  reserved    Int     @default(0)

  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  product   Product            @relation(fields: [productId], references: [id])
  movements Movement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId])
  @@map("stocks")
}

model Movement {
  id        String       @id @default(uuid())
  stockId   String
  type      MovementType
  quantity  Int
  beforeQty Int
  afterQty  Int
  reference String?
  remarks   String?

  stock Stock @relation(fields: [stockId], references: [id])

  createdAt DateTime @default(now())

  @@map("movements")
}

model Supplier {
  id            String     @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  website       String?
  address       String?
  logo          String?
  notes         String?
  isActive      Boolean    @default(true)
  purchases     Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("suppliers")
}

model Purchase {
  id           String         @id @default(uuid())
  supplierId   String
  invoice      String         @unique
  purchaseDate DateTime
  receivedAt   DateTime?
  status       PurchaseStatus @default(PENDING)
  total        Decimal        @db.Decimal(12, 2)
  notes        String?

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  items    PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Int
  price      Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

model Transfer {
  id              String         @id @default(uuid())
  code            String         @unique
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus @default(PENDING)
  notes           String?

  fromWarehouse Warehouse      @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse      @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  items         TransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transfers")
}

model TransferItem {
  id         String @id @default(uuid())
  transferId String
  productId  String
  quantity   Int

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("transfer_items")
}

model Setting {
  id                   String  @id @default(uuid())
  warehouseName        String
  warehouseCode        String
  warehouseAddress     String
  warehouseCapacity    Int
  lowStockAlert        Boolean @default(true)
  dailyReport          Boolean @default(true)
  transferNotification Boolean @default(true)
  autoBackup           Boolean @default(true)
  sessionTimeout       Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ============================================================================
// M-PLOYEE - sistem informasi HR
// ============================================================================

model Region {
  id        String    @id @default(uuid())
  name      String
  countries Country[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("regions")
}

model Country {
  id        String     @id @default(uuid())
  regionId  String
  name      String
  region    Region     @relation(fields: [regionId], references: [id], onDelete: Cascade)
  locations Location[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("countries")
}

model Location {
  id            String       @id @default(uuid())
  countryId     String
  streetAddress String?
  postalCode    String?
  city          String
  stateProvince String?

  country     Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
}

model Department {
  id         String            @id @default(uuid())
  locationId String
  name       String

  location  Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employees EmployeeProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Job {
  id        String            @id @default(uuid())
  title     String
  minSalary Decimal           @db.Decimal(12, 2)
  maxSalary Decimal           @db.Decimal(12, 2)
  employees EmployeeProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("jobs")
}

model EmployeeProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  departmentId String?
  jobId        String?
  phoneNumber  String?
  hireDate     DateTime?
  salary       Decimal?  @db.Decimal(12, 2)
  image        String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  job        Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  dependents Dependent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_profiles")
}

model Dependent {
  id            String @id @default(uuid())
  employeeId    String
  firstName     String
  lastName      String
  relationship  String?

  employee EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dependents")
}

// ============================================================================
// CODIGRAM - media sosial
// ============================================================================

model PostCategory {
  id          String @id @default(uuid())
  name        String
  description String?
  posts       Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("post_categories")
}

model Post {
  id         String  @id @default(uuid())
  userId     String
  categoryId String
  caption    String?
  imageUrl   String?

  author   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category PostCategory  @relation(fields: [categoryId], references: [id])
  comments PostComment[]
  likes    PostLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

model PostComment {
  id      String @id @default(uuid())
  postId  String
  userId  String
  message String

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("post_comments")
}

model PostLike {
  postId String
  userId String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@map("post_likes")
}

// ============================================================================
// LEATHER SHELF - katalog buku
// ============================================================================

model Author {
  id      String       @id @default(uuid())
  name    String
  bio     String?
  books   BookAuthor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("authors")
}

model Publisher {
  id      String @id @default(uuid())
  name    String
  website String?
  books   Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("publishers")
}

model Genre {
  id    String      @id @default(uuid())
  name  String      @unique
  books BookGenre[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("genres")
}

model Book {
  id            String  @id @default(uuid())
  publisherId   String
  title         String
  isbn          String  @unique
  publishedYear Int?
  description   String?
  coverUrl      String?
  totalCopies   Int     @default(1)

  publisher Publisher    @relation(fields: [publisherId], references: [id])
  authors   BookAuthor[]
  genres    BookGenre[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("books")
}

model BookAuthor {
  bookId   String
  authorId String

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@map("book_authors")
}

model BookGenre {
  bookId  String
  genreId String

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([bookId, genreId])
  @@map("book_genres")
}

model Review {
  id      String  @id @default(uuid())
  userId  String
  bookId  String
  rating  Int
  comment String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@map("reviews")
}
